# Copy to deploy/.env using deploy/scripts/bootstrap.sh.
# Local-only defaults; no credentials belong in this file.
COMPOSE_PROJECT_NAME=sharewise-p26ab-local
SHAREWISE_PUBLIC_HOST=localhost
SHAREWISE_HTTP_BIND=127.0.0.1
SHAREWISE_HTTP_PORT=18080
SHAREWISE_HTTPS_BIND=127.0.0.1
SHAREWISE_HTTPS_PORT=8443
# Optional image override variables for deployment testing:
# SHAREWISE_BACKEND_IMAGE=sharewise-backend:local
# SHAREWISE_FRONTEND_IMAGE=sharewise-frontend:local
