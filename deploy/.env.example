# Copy to deploy/.env using deploy/scripts/bootstrap.sh.
# Local-only defaults; no credentials belong in this file.
COMPOSE_PROJECT_NAME=sharewise-p26ab-local
SHAREWISE_PUBLIC_HOST=localhost
SHAREWISE_HTTP_BIND=127.0.0.1
SHAREWISE_HTTP_PORT=18080
SHAREWISE_HTTPS_BIND=127.0.0.1
SHAREWISE_HTTPS_PORT=8443
# IAM: local-only generation; use require-existing for externally managed production keys.
SHAREWISE_IAM_KEY_MODE=generate-if-absent
SHAREWISE_IAM_ACTIVE_KEY_ID=iam-local-1
SHAREWISE_IAM_ISSUER=https://localhost:8443
SHAREWISE_IAM_AUDIENCE=sharewise-api
# Optional: publish PostgreSQL on Docker Desktop loopback for devcontainer inspection.
# Enable the Compose override; customize bind address/port only if needed.
# COMPOSE_FILE=compose.yaml:compose.postgres-host.yaml
# SHAREWISE_POSTGRES_BIND=127.0.0.1
# SHAREWISE_POSTGRES_PORT=15432
# Optional image override variables for deployment testing:
# SHAREWISE_BACKEND_IMAGE=sharewise-backend:local
# SHAREWISE_FRONTEND_IMAGE=sharewise-frontend:local
