# Copy to .local/production/compose.env, or use scripts/prepare-production-local.sh.
# This is a disposable local test stack. Never put credentials in this file.
COMPOSE_PROJECT_NAME=sharewise-p26ab-local
SHAREWISE_PUBLIC_HOST=sharewise.test
SHAREWISE_HTTP_BIND=127.0.0.1
SHAREWISE_HTTP_PORT=8080
SHAREWISE_HTTPS_BIND=127.0.0.1
SHAREWISE_HTTPS_PORT=8443
# Optional overrides for image tags or externally provisioned paths:
# SHAREWISE_BACKEND_IMAGE=sharewise-backend:local
# SHAREWISE_FRONTEND_IMAGE=sharewise-frontend:local
# SHAREWISE_SECRETS_DIR=./.local/production/secrets
# SHAREWISE_TLS_DIR=./.local/production/tls
