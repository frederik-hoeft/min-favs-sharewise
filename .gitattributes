# Normalize text files and use LF in the working tree.
* text=auto eol=lf

# Java and build configuration.
*.java          text eol=lf
*.gradle        text eol=lf
*.gradle.kts    text eol=lf
*.properties    text eol=lf
*.xml           text eol=lf
*.sql           text eol=lf
*.json          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.toml          text eol=lf

# Scripts.
*.sh            text eol=lf
gradlew         text eol=lf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Binary assets.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.webp          binary
*.pdf           binary
*.zip           binary
*.jar           binary
*.class         binary
*.woff          binary
*.woff2         binary